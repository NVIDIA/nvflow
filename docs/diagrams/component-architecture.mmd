%% NVFlow - Component Architecture
%% Shows the core framework components and their relationships

classDiagram
    %% Core Framework Classes
    class BaseStage {
        <<abstract>>
        +workflow: str
        +execute(config, cluster, expname, run_after)* abstract
        +validate_config(config) optional
        +get_dependencies(config) list
    }

    class StageRegistry {
        <<singleton>>
        -_stages: Dict~str,Dict~
        -_recipe_configs: Dict
        +register(recipe, workflow, stage)$ decorator
        +get(recipe, workflow, stage)$ StageClass
        +has(recipe, workflow, stage)$ bool
        +list_recipes()$ List~str~
        +list_workflows(recipe)$ List~str~
        +list_stages(recipe, workflow)$ List~str~
        +list_all_stages()$ List~tuple~
        +clear()$ void
    }

    class WorkflowRunner {
        -config: Dict
        -config_path: Path
        -recipe: str
        -workflow_name: str
        -workflow_type: str
        -cluster: str
        +__init__(config_path)
        +run(stages: Optional~List~) void
        +validate_config() void
        -_run_stage(stage_name) void
        -_load_config_with_inheritance() OmegaConf
        -_expand_dynamic_stages() void
        -_get_expname(stage_name, config) str
        -_validate_stages(stages, all_stages) void
    }

    class Console {
        <<utility>>
        +header(text) void
        +section(text) void
        +info(text) void
        +detail(key, value) void
        +success(text) void
        +error(text) void
        +warning(text) void
    }

    %% CLI Layer
    class CLI {
        <<typer app>>
        +list_stages(config, recipe, workflow)
        +stage_info(stage_path, recipe, workflow)
        +run(stages, config)
        +run_all(config)
        +validate(config)
        +version()
    }

    %% Concrete Stage Examples
    class SFTStage {
        +workflow: "sft"
        +execute(config, cluster, expname, run_after)
        +validate_config(config)
    }

    class GenerateAnswersStage {
        +workflow: "template_based_sdg"
        +execute(config, cluster, expname, run_after)
    }

    class DownloadSECStage {
        +workflow: "download_sec_filings"
        +execute(config, cluster, expname, run_after)
    }

    class EvaluateStage {
        +workflow: "eval"
        +execute(config, cluster, expname, run_after)
        +validate_config(config)
    }

    %% External Dependencies
    class NemoSkills {
        <<external>>
        +pipeline.run()
        +generate()
        +evaluate()
    }

    class OmegaConf {
        <<external library>>
        +load(path) DictConfig
        +merge(*configs) DictConfig
        +to_container(config) Dict
    }

    %% Relationships
    BaseStage <|-- SFTStage : implements
    BaseStage <|-- GenerateAnswersStage : implements
    BaseStage <|-- DownloadSECStage : implements
    BaseStage <|-- EvaluateStage : implements

    StageRegistry --> BaseStage : manages
    StageRegistry ..> SFTStage : registers
    StageRegistry ..> GenerateAnswersStage : registers
    StageRegistry ..> DownloadSECStage : registers
    StageRegistry ..> EvaluateStage : registers

    WorkflowRunner ..> StageRegistry : uses
    WorkflowRunner ..> BaseStage : instantiates & executes
    WorkflowRunner ..> Console : uses for UI
    WorkflowRunner ..> OmegaConf : uses for config

    CLI ..> WorkflowRunner : creates & runs
    CLI ..> StageRegistry : queries

    SFTStage ..> NemoSkills : delegates to
    GenerateAnswersStage ..> NemoSkills : delegates to
    EvaluateStage ..> NemoSkills : delegates to

    %% Notes
    note for BaseStage "All stages inherit from BaseStage\nand implement execute() method.\nStages are registered via decorator:\n@StageRegistry.register(\n  recipe='finance',\n  workflow='sft',\n  stage='sft'\n)"

    note for StageRegistry "Hierarchical registry:\nRecipe → Workflow → Stage\n\nExample:\nfinance.sft.sft\n↓\nSFTStage class"

    note for WorkflowRunner "Loads YAML configs with\ninheritance support (_base_ key)\nManages stage dependencies\nGenerates unique expnames"

    note for NemoSkills "External library from NVIDIA\nProvides SDG, training,\nevaluation pipelines"

    %% Styling
    class BaseStage abstractClass
    class StageRegistry singletonClass
    class WorkflowRunner mainClass
    class Console utilityClass
    class CLI interfaceClass
    class NemoSkills externalClass
    class OmegaConf externalClass

