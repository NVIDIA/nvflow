# syntax=docker/dockerfile:1
# =============================================================================
# NVFlow NeMo-RL image (nvflow-nemo-rl)
# =============================================================================
# NeMo-RL 0.8.0 with the Gym component environments that NVFlow's GRPO
# workflows train with built in, so training installs nothing at runtime. The
# base image builds none of them (its build leaves NEMO_GYM_PREFETCH_CONFIGS
# empty); NVFlow's GRPO configs set skip_venv_if_present, so Gym reuses the
# ones built here.
#
# Build (dual architecture; see docker_instructions.md):
#   REGISTRY=<registry-host>/<namespace> scripts/build_images.sh nemo-rl
# =============================================================================
ARG NEMO_RL_IMAGE=nvcr.io/nvidia/nemo-rl:v0.8.0

FROM ${NEMO_RL_IMAGE}
ARG NEMO_RL_IMAGE
LABEL org.opencontainers.image.base.name="${NEMO_RL_IMAGE}"
USER root

ARG GYM_SRC=/opt/nemo-rl/3rdparty/Gym-workspace/Gym
ARG GYM_VENV=/opt/ray_venvs/nemo_rl.environments.nemo_gym.NemoGym

# One venv per Gym server, in NEMO_GYM_VENV_DIR where NeMo-RL looks for them.
# Running Gym from the NemoGym actor venv pins each server to that interpreter's
# Python and Ray. The venvs are hardlinked because Gym's setup runs
# `uv pip install --no-cache`, which uv refuses to combine with symlinks, and
# they keep the directory's owner so a non-root runtime user can use them.
WORKDIR ${GYM_SRC}
RUN <<"EOF" bash -eux -o pipefail
test -z "$(ls -A "${NEMO_GYM_VENV_DIR}")"
owner=$(stat -c '%u:%g' "${NEMO_GYM_VENV_DIR}")
export UV_LINK_MODE=hardlink

for server in equivalence_llm_judge mcqa finance_sec_search; do
    "${GYM_VENV}/bin/gym" env prefetch --model-type vllm_model --resources-server "${server}" \
        "+uv_venv_dir=${NEMO_GYM_VENV_DIR}" +skip_venv_if_present=true \
        +policy_base_url=http://unused.invalid/v1 +policy_api_key=EMPTY +policy_model_name=unused
done
chown -R "${owner}" "${NEMO_GYM_VENV_DIR}"
EOF
WORKDIR /opt/nemo-rl

# Ray refuses to join a cluster on a different Ray or Python version, so every
# actor and Gym venv must match the image's own environment. Gym also passes
# uvicorn.run(timeout_worker_healthcheck=), which needs uvicorn 0.37 or newer,
# without declaring that floor.
RUN <<"EOF" bash -eux -o pipefail
want_python=$(/opt/nemo_rl_venv/bin/python -c "import platform; print(platform.python_version())")
want_ray=$(/opt/nemo_rl_venv/bin/python -c "import ray; print(ray.__version__)")
for component in resources_servers/equivalence_llm_judge resources_servers/mcqa \
        resources_servers/finance_sec_search responses_api_models/vllm_model \
        responses_api_agents/simple_agent responses_api_agents/finance_agent; do
    test -x "${NEMO_GYM_VENV_DIR}/${component}/.venv/bin/python"
done
for python in /opt/ray_venvs/*/bin/python "${NEMO_GYM_VENV_DIR}"/*/*/.venv/bin/python; do
    test "$("${python}" -c "import platform; print(platform.python_version())")" = "${want_python}"
    ray=$("${python}" -c "import ray; print(ray.__version__)" 2>/dev/null || true)
    test -z "${ray}" || test "${ray}" = "${want_ray}"
done
for python in "${NEMO_GYM_VENV_DIR}"/*/*/.venv/bin/python; do
    "${python}" -c "import inspect, uvicorn; assert 'timeout_worker_healthcheck' in inspect.signature(uvicorn.run).parameters, uvicorn.__version__"
done
EOF

# Anything that tries to install at runtime fails instead of reaching for the
# network.
ENV UV_OFFLINE=true
