# syntax=docker/dockerfile:1
# =============================================================================
# NVFlow NeMo-Gym image (nvflow-nemo-gym)
# =============================================================================
# NeMo-Gym 0.7.0 with every Gym component environment NVFlow's workflows use
# built in, so Gym jobs install nothing at runtime. The base image builds none
# of them (its build leaves NEMO_GYM_PREFETCH_CONFIGS empty); NVFlow's Gym
# stages set skip_venv_if_present, so Gym reuses the ones built here.
#
# Build (dual architecture; see docker_instructions.md):
#   REGISTRY=<registry-host>/<namespace> scripts/build_images.sh nemo-gym
# =============================================================================
ARG NEMO_GYM_IMAGE=nvcr.io/nvidia/nemo-gym:v0.7.0

FROM ${NEMO_GYM_IMAGE}
ARG NEMO_GYM_IMAGE
ARG TARGETARCH
LABEL org.opencontainers.image.base.name="${NEMO_GYM_IMAGE}"
USER root

# The upstream image is a CLI image (`ENTRYPOINT ["gym"]`). NVFlow submits
# shell scripts, so reset it while retaining Gym on PATH.
ENTRYPOINT []
WORKDIR /opt/nemo-gym
ENV PATH="/opt/nemo_gym_venv/bin:${PATH}" \
    UV_OFFLINE=true

# Gym's local vLLM server, in its own layer because it is the largest. Gym pins
# vllm==0.25.1 and lets uv pick torch for the build host's GPU driver, which a
# GPU-less build resolves to CPU torch; as NeMo-RL's Dockerfile does for Gym,
# install vLLM's prebuilt CUDA 13 wheel with CUDA 13 torch. Removing any
# inherited tree keeps Gym's setup guard from accepting an incomplete one.
RUN <<'EOF' bash -eux -o pipefail
unset UV_OFFLINE
case "${TARGETARCH}" in arm64) wheel_arch=aarch64 ;; *) wheel_arch=x86_64 ;; esac
printf 'vllm @ https://github.com/vllm-project/vllm/releases/download/v0.25.1/vllm-0.25.1-cp38-abi3-manylinux_2_28_%s.whl\n' \
  "${wheel_arch}" > /tmp/gym-vllm.txt
local_component=responses_api_models/local_vllm_model
rm -rf "$local_component/.venv"
UV_TORCH_BACKEND=cu130 UV_OVERRIDE=/tmp/gym-vllm.txt gym env prefetch \
  --config responses_api_models/local_vllm_model/configs/local_vllm_model.yaml \
  +policy_model_name=unused
rm /tmp/gym-vllm.txt

"$local_component/.venv/bin/python" - <<'PY'
import platform
from importlib.metadata import version

import torch
from vllm.reasoning import ReasoningParserManager

expected = {"vllm": "0.25.1", "ray": "2.58.0", "openai": "2.44.0"}
actual = {package: version(package) for package in expected}
assert actual == expected, (actual, expected)
assert platform.python_version() == "3.13.14", platform.python_version()
assert (torch.version.cuda or "").startswith("13."), torch.version.cuda
assert "nemotron_v3" in ReasoningParserManager.list_registered()
PY
EOF

COPY nvflow/integrations/nemo_gym/configs/format_verification.yaml \
    /opt/nvflow/configs/sdg_format_verification.yaml

# Every other component environment the maintained workflows use. Separate
# invocations avoid composing multiple policy_model definitions.
RUN <<'EOF' bash -eux -o pipefail
unset UV_OFFLINE
external_model=responses_api_models/vllm_model/configs/vllm_model.yaml

prefetch() {
  gym env prefetch \
    --config "$external_model" \
    --config "$1" \
    +policy_base_url=http://unused.invalid/v1 \
    +policy_api_key=EMPTY \
    +policy_model_name=unused \
    +skip_venv_if_present=true
}

prefetch resources_servers/equivalence_llm_judge/configs/equivalence_llm_judge.yaml
prefetch resources_servers/finance_sec_search/configs/finance_sec_search.yaml
prefetch resources_servers/finance_agent_v2/configs/finance_agent_v2.yaml
prefetch resources_servers/mcqa/configs/mcqa.yaml
prefetch /opt/nvflow/configs/sdg_format_verification.yaml

for component in \
  responses_api_models/vllm_model \
  responses_api_models/local_vllm_model \
  responses_api_models/openai_model \
  responses_api_agents/simple_agent \
  responses_api_agents/finance_agent \
  resources_servers/equivalence_llm_judge \
  resources_servers/finance_sec_search \
  resources_servers/finance_agent_v2 \
  resources_servers/mcqa \
  resources_servers/format_verification; do
  test -x "$component/.venv/bin/python"
done
EOF

RUN <<'EOF' bash -eux -o pipefail
# Gym requires uvicorn's worker-health timeout argument.
python -c "import inspect,uvicorn; assert 'timeout_worker_healthcheck' in inspect.signature(uvicorn.run).parameters"

gym --version
gym eval run --help >/dev/null
gym eval aggregate --help >/dev/null
gym eval profile --help >/dev/null
gym eval health-check --help >/dev/null
gym eval reverify --help >/dev/null
gym eval compare --help >/dev/null
EOF

CMD ["bash"]
