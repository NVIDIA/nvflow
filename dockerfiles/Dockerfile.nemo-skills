# =============================================================================
# NVFlow NeMo-Skills Container
#
# 1. UPSTREAM (NeMo-Skills' Dockerfile at a pinned commit, kept diffable),
# 2. NVFLOW (packages the workflow steps import), 3. deterministic resolution.
# Upstream:
# https://github.com/NVIDIA-NeMo/Skills/blob/main/dockerfiles/Dockerfile.nemo-skills
#
# Build (dual architecture; see docker_instructions.md):
#   REGISTRY=<registry-host>/<namespace> scripts/build_images.sh nemo-skills
# =============================================================================

# NeMo-Skills at a pinned commit, replacing upstream's build-context COPYs.
FROM scratch AS nemo-skills-src
ARG NEMO_SKILLS_COMMIT=bcf059af55c20a89f797724598f9908d126153e6
ADD --keep-git-dir=true https://github.com/NVIDIA-NeMo/Skills.git#${NEMO_SKILLS_COMMIT} /

FROM scratch AS sdp-src
ARG SDP_COMMIT=29b9b1ec0ceaf3ffa441c1d01297371b3f8e11d2
ADD https://github.com/NVIDIA/NeMo-speech-data-processor.git#${SDP_COMMIT} /

# Keep uv's Python wheel and its build-environment SBOM out of the runtime
# image. Only the standalone, version-pinned executable crosses this stage.
FROM ghcr.io/astral-sh/uv:0.12.9 AS uv-installer


# ===========================================================================
# 1. BEGIN UPSTREAM -- github.com/NVIDIA-NeMo/Skills @ bcf059af
# Deviations, so a diff after re-syncing shows only these:
#   - COPY -> COPY --from=nemo-skills-src (pinned SHA instead of build context)
#   - unused benchmark trees (google-research, Gorilla/BFCL, IFBench) omitted
#   - spaCy `en_core_web_sm` download omitted (spaCy came only from those trees)
#   - `cd /tmp` before the nltk download (upstream defect; see below)
#   - apt Python replaced by uv-managed Python 3.13.14 under /opt/python, with
#     uv's EXTERNALLY-MANAGED marker removed so pip and uv can install into it
#   - dependency resolution deferred to section 3's pinned uv stage
#   - SDP installed in section 3 without its numpy==1.26 pin, which has no
#     Python 3.13 release
# Do not add --no-install-recommends below: it drops gpg-agent, which
# add-apt-repository needs for the apptainer PPA key.
# ===========================================================================

# using ubuntu instead of debian for easier apptainer installation on arm64
FROM ubuntu:22.04 AS runtime-base
ARG PYTHON_VERSION=3.13.14

COPY --from=uv-installer /uv /usr/local/bin/uv

# Install Python and other dependencies
RUN apt-get update && \
    apt-get install -y \
    python3 \
    curl \
    ca-certificates \
    wget \
    git \
    git-lfs \
    ffmpeg && \
    rm -rf /var/cache/apt/archives /var/lib/apt/lists/*

RUN UV_PYTHON_INSTALL_DIR=/opt/python uv python install "${PYTHON_VERSION}" && \
    managed_python="$(find /opt/python -type f -path '*/bin/python3.13' -print -quit)" && \
    test -n "${managed_python}" && \
    ln -sf "${managed_python}" /usr/local/bin/python && \
    ln -sf "${managed_python}" /usr/local/bin/python3 && \
    rm -f "$(python -c 'import sysconfig; print(sysconfig.get_path("stdlib"))')/EXTERNALLY-MANAGED" && \
    python -m ensurepip --upgrade && \
    ln -sf "$(dirname "${managed_python}")/pip3" /usr/local/bin/pip && \
    python -m pip install --no-cache-dir --upgrade pip setuptools && \
    rm -f /usr/local/bin/uv && \
    python -c "import platform; assert platform.python_version() == '${PYTHON_VERSION}', platform.python_version()"

# Update package lists and install apptainer for arm64
# https://apptainer.org/docs/admin/1.1/installation.html
RUN apt update && \
    apt install -y software-properties-common && \
    add-apt-repository -y ppa:apptainer/ppa && \
    apt update && apt -y install apptainer && \
    add-apt-repository -y ppa:apptainer/ppa && \
    apt update && apt install -y apptainer-suid && \
    rm -rf /var/cache/apt/archives /var/lib/apt/lists/*

# Apply security patches for PackageKit, pulled in transitively by software-properties-common.
# Ubuntu 22.04 has published 1.2.5-2ubuntu3.1 with the fix for the local privilege escalation CVE.
RUN apt-get update && \
    apt-get install --only-upgrade -y \
        packagekit \
        packagekit-tools \
        libpackagekit-glib2-18 \
        gir1.2-packagekitglib-1.0 && \
    rm -rf /var/cache/apt/archives /var/lib/apt/lists/*

RUN apt remove -y python3-blinker

# Newer nltk blocks imports resolving inside the CWD; at CWD=/ that matches
# every stdlib path, so `import nltk` needs the `cd`.
RUN pip install langdetect absl-py immutabledict nltk ipython && \
    cd /tmp && python -c "import nltk; nltk.download('punkt'); nltk.download('punkt_tab'); \
    nltk.download('stopwords'); nltk.download('averaged_perceptron_tagger_eng')"

# we aren't copying main nemo_skills folder as it will always be mounted from host
# but we do want to install all requirements in the container directly
RUN mkdir -p /opt/NeMo-Skills/requirements /opt/NeMo-Skills/core
COPY --from=nemo-skills-src /pyproject.toml /opt/NeMo-Skills/pyproject.toml
COPY --from=nemo-skills-src /README.md /opt/NeMo-Skills/README.md
COPY --from=nemo-skills-src /requirements/ /opt/NeMo-Skills/requirements/
COPY --from=nemo-skills-src /core/requirements.txt /opt/NeMo-Skills/core/requirements.txt
ARG CACHEBUST=4
# Section 3 resolves these requirements once with the pinned uv executable.
# Fix http mismatch between lepton and dggs by manually downloading dggs here
RUN pip install ddgs

# ===========================================================================
# END UPSTREAM
# ===========================================================================


# ===========================================================================
# 2. NVFLOW -- imported by workflow steps; baked so no job downloads at launch.
# ===========================================================================

# tzdata populates /usr/share/zoneinfo for pyarrow/pandas libc tz lookups.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends tzdata && \
    rm -rf /var/cache/apt/archives /var/lib/apt/lists/*

# model-library 0.1.8 requires ai21 >=4.3,<5; ai21 4.3 requires
# tenacity >=8.3,<9. Keep this worker image inside their shared range.
RUN pip install --no-cache-dir --ignore-requires-python \
    jsonlines \
    tiktoken \
    markdownify \
    "backoff>=2.2.1" \
    "tenacity>=8.5,<9" \
    func-timeout \
    "tavily==1.1.0" \
    "model-library==0.1.8"

# cl100k_base is used by question_context_utils.py for token counting.
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken_cache
RUN mkdir -p /opt/tiktoken_cache && \
    python3 -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"

# SEC data prep: workflow-2 download_sec_filings, workflow-3 create_seed_data.
RUN pip install --no-cache-dir --ignore-requires-python \
        edgartools==5.20.2 \
        sec-parser \
        pandas \
        pyarrow \
        tqdm \
        httpx \
        tzdata \
        requests \
        beautifulsoup4

# MinHash near-duplicate detection in the shared data.dedup stage.
RUN pip install --no-cache-dir --ignore-requires-python datasketch==2.0.0

RUN python -c "from edgar import set_identity; \
               import sec_parser, pandas, pyarrow, httpx, tzdata, requests, tenacity, datasketch; \
               from bs4 import BeautifulSoup; \
               print('NVFlow deps OK')"


# ===========================================================================
# 3. DETERMINISTIC RESOLUTION -- the pinned NeMo-Skills requirements plus
# NVFlow's Ray and NeMo-Run pins.
# ===========================================================================
# leptonai 0.47 drops leptonai.api.v1, which the pinned nemo-run imports. It is a
# constraint, not an override: an override replaces nemo-run's leptonai>=0.26.6,
# and uv then picks a leptonai old enough to leave Ray out.
# This resolution cannot see what pip installed above, so it keeps packaging and
# python-dateutil under the caps of xai-sdk and botocore (from model-library), and
# lifts anyio past leptonai's anyio<=4.9.0 to the floor of httpx2.
RUN printf '%s\n' \
        'ray[default]==2.58.0' \
        'nemo-run @ git+https://github.com/NVIDIA-NeMo/Run@17ae86b64d7f75653351664f5d8c9e466faede00' \
        'anyio>=4.10' \
        > /tmp/resolution-overrides.txt && \
    printf '%s\n' 'leptonai<0.47' 'packaging<26' 'python-dateutil<3' > /tmp/resolution-constraints.txt

FROM runtime-base AS dependency-installer
COPY --from=uv-installer /uv /usr/local/bin/uv
COPY --from=sdp-src / /tmp/sdp
RUN uv --version | grep -E '^uv 0\.12\.9([[:space:]]|$)'
# editdistance, an SDP requirement, has no Python 3.13 wheel. The compiler stays
# in this stage: the runtime image copies only /usr/local and /opt/python.
RUN apt-get update && \
    apt-get install -y --no-install-recommends g++ && \
    rm -rf /var/cache/apt/archives /var/lib/apt/lists/*
# sentence_transformers pulls torch. The CPU build, which upstream's image gets
# from its BFCL install, keeps PyPI torch's CUDA runtime out of this CPU image.
RUN grep -v -x 'numpy==1.26' /tmp/sdp/requirements/main.txt > /tmp/sdp-requirements.txt && \
    ! grep -q '^numpy' /tmp/sdp-requirements.txt && \
    cd /opt/NeMo-Skills && uv pip install --system --no-cache-dir --torch-backend cpu \
        --override /tmp/resolution-overrides.txt --constraint /tmp/resolution-constraints.txt \
        -r core/requirements.txt -r requirements/pipeline.txt -r /tmp/sdp-requirements.txt && \
    uv pip install --system --no-cache-dir --no-deps /tmp/sdp && \
    rm -f /usr/local/bin/uv && rm -rf /root/.cache/uv

# Copy only the resolved runtime environment; uv and its embedded build SBOM
# remain confined to the throwaway installer stage.
FROM runtime-base
RUN rm -rf /usr/local /opt/python
COPY --from=dependency-installer /usr/local/ /usr/local/
COPY --from=dependency-installer /opt/python/ /opt/python/
ENV RAY_USAGE_STATS_ENABLED=0

RUN python -c "import platform, ray; from importlib.metadata import distributions, version; cuda = sorted(name for name in ((d.metadata['Name'] or '').lower() for d in distributions()) if name.startswith(('nvidia-', 'cuda-')) or name == 'triton'); assert platform.python_version() == '3.13.14', platform.python_version(); assert ray.__version__ == '2.58.0', ray.__version__; assert version('torch').endswith('+cpu'), version('torch'); assert not cuda, cuda; print('Runtime profile OK:', platform.python_version(), ray.__version__, 'torch', version('torch'))" && \
    [ ! -e /usr/local/bin/uv ] && \
    [ -z "$(find /opt/python -type d -name 'uv-*.dist-info' 2>/dev/null)" ]

# Gate the runtime combinations NVFlow actually imports.
RUN python -c "from datasets import load_dataset; from transformers import AutoTokenizer; import transformers, tokenizers, lxml.etree, sec_parser; \
               from datasketch import LeanMinHash, MinHash, MinHashLSH; \
               import cssutils; from litellm import completion; from fastapi import FastAPI; FastAPI(); \
               els = sec_parser.Edgar10QParser().parse('<html><body><p style=\"font-weight:bold\">Item 2. Management Discussion</p><p>Revenue rose 12 percent.</p></body></html>'); \
               assert len(els) >= 2, els; \
               print('gates OK: transformers', transformers.__version__, 'tokenizers', tokenizers.__version__, \
                     'lxml', lxml.etree.__version__, '/', len(els), 'sec elements')"

# Whole-environment check, allowing only the pinned upstream compatibility
# overrides and SDP's inherited NumPy mismatch.
RUN printf '%s\n' \
        'leptonai .* requirement httpx' \
        'leptonai .* requirement anyio' \
        'torchx .* requirement urllib3' \
        'sdp .* requirement numpy' \
        'No broken requirements found' \
        > /tmp/pipcheck-allow.txt; \
    pip check > /tmp/pipcheck.txt 2>&1 || true; \
    if grep -vEf /tmp/pipcheck-allow.txt /tmp/pipcheck.txt | grep -q '[^[:space:]]'; then \
        echo "ERROR: unexpected dependency inconsistency:"; cat /tmp/pipcheck.txt; exit 1; \
    fi; \
    cat /tmp/pipcheck.txt

RUN rm -rf /tmp/resolution-overrides.txt /tmp/resolution-constraints.txt /tmp/pipcheck.txt /tmp/pipcheck-allow.txt
