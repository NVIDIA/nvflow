# syntax=docker/dockerfile:1
# =============================================================================
# NVFlow client image -- `nvflow` + baked project launcher environments.
#
# Lean, unprivileged orchestration image: `nvflow` submits Slurm jobs over an SSH
# tunnel, so no Slurm client / munge / podman / enroot is needed inside. Worker
# images stay as .sqsh on the cluster (referenced in my_cluster.yaml), not here.
#
# Build from the repo root, on a committed tree (.baked_commit records HEAD).
# .dockerignore drops cache/, .venv and secrets; .git is kept for hatch-vcs
# versioning, then squashed to a single history-free commit so the image ships
# no repo history. Build from a normal clone, not a linked worktree:
#   REGISTRY=<registry-host>/<namespace> scripts/build_images.sh nvflow-client
#
# Usage: see docs/operations/remote-launch.md.
# =============================================================================

ARG PYTHON_VERSION=3.13.14
ARG NVFLOW_PREWARM_PROJECTS="all"
# Pin the multi-arch Ubuntu 24.04 manifest so a rebuild cannot silently move to
# a new OS release. Python is installed by uv as a managed CPython build
# because Ubuntu 24.04 does not provide the required 3.13.14 interpreter.
ARG UBUNTU_IMAGE=ubuntu:24.04@sha256:562111b88caa79c71391c0c4d3c2114a7d5c35915c20561fd893cb1e07929e6b

# --- builder: resolve the venv (build tools stay out of the final image) -----
FROM ${UBUNTU_IMAGE} AS builder
ARG PYTHON_VERSION
ARG NVFLOW_PREWARM_PROJECTS
ENV DEBIAN_FRONTEND=noninteractive \
    UV_INSTALL_DIR=/usr/local/bin \
    UV_CACHE_DIR=/opt/uv-cache \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    NVFLOW_PROJECT_ENV_CACHE=/opt/nvflow-project-environments \
    UV_PYTHON_PREFERENCE=only-managed

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates build-essential \
    && rm -rf /var/lib/apt/lists/*

# uv on a system path (not /root/.local) so it survives enroot's $HOME remap.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
RUN uv python install "${PYTHON_VERSION}"

COPY . /opt/nvflow
WORKDIR /opt/nvflow
# Record the baked commit for provenance, and hide it from git so the baked tree
# stays clean (nemo-run packages via `git archive` of HEAD regardless).
RUN test -d .git || { \
        echo "ERROR: nvflow-client must be built from a normal Git clone, not a linked worktree" >&2; \
        exit 1; \
    } && \
    git rev-parse HEAD > /opt/nvflow/.baked_commit && \
    git_dir="$(git rev-parse --git-dir)" && \
    mkdir -p "${git_dir}/info" && \
    echo '.baked_commit' >> "${git_dir}/info/exclude"

# --frozen pins to the committed uv.lock; execution installs the full launcher
# stack while --no-dev skips the debugger.
RUN uv venv .venv --python "${PYTHON_VERSION}" && \
    uv sync --frozen --no-dev --extra execution --extra ray && \
    mkdir -p /opt/nvflow-project-environments
# Release images bake every discovered project. A space-separated subset is
# available only for smaller development images.
RUN if [ "${NVFLOW_PREWARM_PROJECTS}" = "all" ]; then \
        .venv/bin/nvflow sync-project --all; \
    elif [ -n "${NVFLOW_PREWARM_PROJECTS}" ]; then \
        for project in ${NVFLOW_PREWARM_PROJECTS}; do \
            .venv/bin/nvflow sync-project --project "${project}"; \
        done; \
    fi
# Drop build caches and bytecode.
RUN rm -rf /opt/uv-cache && \
    find /opt/nvflow -depth -type d -name __pycache__ -exec rm -rf {} + && \
    find /opt/nvflow -type f -name '*.pyc' -delete && \
    find /opt/nvflow-project-environments -depth -type d -name __pycache__ -exec rm -rf {} + && \
    find /opt/nvflow-project-environments -type f -name '*.pyc' -delete
# --- image-scan remediation: start ------------------------------------------
# Each step deletes an unused bundled component that image scans report. Drop a
# step once the package that bundles it ships a fixed copy.
# uv performs every install, so the managed interpreter's own pip is unused; its
# bundled msgpack, setuptools, and urllib3 are what image scans report.
RUN rm -rf /opt/python/cpython-*/lib/python3.*/site-packages/pip \
        /opt/python/cpython-*/lib/python3.*/site-packages/pip-*.dist-info \
        /opt/python/cpython-*/bin/pip*
# The launcher drives Ray only through the Jobs HTTP API, so Ray's Java jars are
# unused; their bundled Java libraries are what image scans report.
RUN find /opt/nvflow/.venv /opt/nvflow-project-environments -type d \
        -path '*/site-packages/ray/jars' -prune -exec rm -rf {} +
# Only Ray's runtime-env agent, which runs on Ray nodes and never in the
# launcher, loads these vendored packages; their aiohttp is what image scans report.
RUN find /opt/nvflow/.venv /opt/nvflow-project-environments -type d \
        -path '*/site-packages/ray/_private/runtime_env/agent/thirdparty_files' -prune -exec rm -rf {} +
# --- image-scan remediation: end --------------------------------------------
# Verify the qualified Python and Ray versions in every environment.
RUN for python in /opt/nvflow/.venv/bin/python \
        $(find /opt/nvflow-project-environments -path '*/.venv/bin/python' \( -type f -o -type l \)); do \
        "${python}" -c "import platform, ray; assert platform.python_version() == '3.13.14'; assert ray.__version__ == '2.58.0'; print('runtime OK', platform.python_version(), ray.__version__)"; \
    done

# Ship a history-free repo. hatch-vcs versioning already ran during `uv sync`
# (static nvflow/_version.py written above), and nemo-run only needs
# `git archive HEAD` (current tree) -- a distributed image must not carry repo
# history. Replace the full .git with a single snapshot commit that reproduces
# the customer runtime tracked set while expanding pinned submodule contents.
# Internal agent/Codex tooling and generated recipe-golden harnesses are
# deliberately excluded from the distributed image. Re-add with
# --force so tracked-but-gitignored files (for example, a project-owned data
# package's __init__.py) are preserved. Plain
# `git add -A` respects .gitignore and would silently drop them, changing what
# `git archive HEAD` ships to the compute nodes. The assertion guards this.
RUN cd /opt/nvflow && \
    .venv/bin/python scripts/materialize_git_snapshot.py \
        --root . \
        --output /tmp/tracked \
        --exclude .agents \
        --exclude .codex \
        --exclude tests/golden/recipe_config \
        --exclude tests/test_recipe_config_golden.py && \
    tar --null --files-from=/tmp/tracked -cf /tmp/tracked.tar && \
    cp nvflow/_version.py /tmp/nvflow-version.py && \
    find . -mindepth 1 -maxdepth 1 ! -name .venv ! -name .baked_commit -exec rm -rf {} + && \
    tar -xf /tmp/tracked.tar && \
    cp /tmp/nvflow-version.py nvflow/_version.py && \
    git init -q -b main && \
    echo '.baked_commit' >> .git/info/exclude && \
    git -c user.email=release@nvidia.com -c user.name=nvflow add --pathspec-from-file=/tmp/tracked --pathspec-file-nul --force && \
    git -c user.email=release@nvidia.com -c user.name=nvflow commit -q -m "nvflow baked release snapshot" && \
    git ls-files -z | sort -z > /tmp/after && sort -z /tmp/tracked > /tmp/before && \
    cmp -s /tmp/before /tmp/after && \
    [ ! -e .agents ] && [ ! -e .codex ] && \
    [ ! -e tests/golden/recipe_config ] && [ ! -e tests/test_recipe_config_golden.py ] && \
    echo "snapshot tree == materialized customer runtime tracked set" && \
    rm -f /tmp/tracked /tmp/tracked.tar /tmp/nvflow-version.py /tmp/before /tmp/after

# --- final: slim runtime = base + venv + source(.git snapshot) + launcher ------
FROM ${UBUNTU_IMAGE}
ARG PYTHON_VERSION
ARG NVFLOW_PREWARM_PROJECTS
LABEL org.opencontainers.image.title="nvflow-client" \
      org.opencontainers.image.description="NVFlow launcher (nvflow CLI) for airgap use"

# Launcher runtime deps: git (nemo-run `git archive`), openssh-client (ssh_tunnel),
# rsync (code sync to job_dir), and ca-certificates.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        openssh-client \
        rsync \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ssh_tunnel host-key handling. nemo-run authenticates the tunnel via paramiko
# (given the key explicitly), but then rsyncs code with plain `ssh -i <key>`,
# which reads known_hosts from $HOME/.ssh — NOT from the mounted /opt/ssh. On a
# fresh container $HOME/.ssh is empty, so rsync dies with "Host key verification
# failed". Point ssh at the *mounted* known_hosts and auto-accept a first-ever
# connect (written back to the mounted dir, so it persists) — no manual priming.
# System-wide via the ssh_config Include, so it holds for any HOME/uid, enroot or
# docker, on-cluster or off. Deliberately no IdentityFile here: nemo-run passes
# -i explicitly, and this stays agnostic to the user's key name.
RUN printf 'Host *\n    UserKnownHostsFile /opt/ssh/known_hosts\n    StrictHostKeyChecking accept-new\n' \
        > /etc/ssh/ssh_config.d/10-nvflow-tunnel.conf

COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv
COPY --from=builder /opt/python /opt/python
COPY --from=builder /opt/nvflow /opt/nvflow
COPY --from=builder /opt/nvflow-project-environments /opt/nvflow-project-environments

# System gitconfig (not /root, which enroot remaps) so `git archive` doesn't trip
# git's "dubious ownership" guard when the container runs as a mapped uid.
RUN git config --system --add safe.directory /opt/nvflow

# enroot ignores ENV PATH; symlink the nvflow console script onto the default PATH.
RUN ln -sf /opt/nvflow/.venv/bin/nvflow /usr/local/bin/nvflow

# UV_OFFLINE + UV_NO_SYNC: `uv run nvflow` runs in the baked venv with no network
# and no pre-run sync (a sync would try to fetch the skipped dev group and fail).
# NEMO_SKILLS_DISABLE_UNCOMMITTED_CHANGES_CHECK: the image bakes a fixed committed
# snapshot; nemo-run packages HEAD via `git archive`, so its uncommitted-changes
# gate is a false positive here (build artifacts like the venv make the tree look
# dirty). Disabling it lets the launcher package the baked commit unattended.
ENV VIRTUAL_ENV=/opt/nvflow/.venv \
    NVFLOW_PROJECT_ENV_CACHE=/opt/nvflow-project-environments \
    PATH=/opt/nvflow/.venv/bin:/usr/local/bin:$PATH \
    NVFLOW_CONFIG_DIR=/opt/nvflow/cluster_configs \
    UV_CACHE_DIR=/tmp/uv-cache \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_PYTHON_PREFERENCE=only-managed \
    UV_OFFLINE=1 \
    UV_NO_SYNC=1 \
    NEMO_SKILLS_DISABLE_UNCOMMITTED_CHANGES_CHECK=1

WORKDIR /opt/nvflow
RUN if [ "${NVFLOW_PREWARM_PROJECTS}" = "all" ]; then \
        nvflow sync-project --all --check; \
    else \
        for project in ${NVFLOW_PREWARM_PROJECTS}; do \
            nvflow sync-project --project "${project}" --check; \
        done; \
    fi
